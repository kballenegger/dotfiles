#!/bin/sh
# NOTE: shebang so vim syntax highlights

# ----------------------------------------------------------------- #
#                                                                   #
#           Kenneth Ballenegger's Awesome .shellrc                  #
#                                                                   #
# ----------------------------------------------------------------- #


# -----------------------------------------------------------------
# SHELL CONFIGURATION
# -----------------------------------------------------------------

export CLICOLOR="xterm-256color"
export LC_ALL="en_US.UTF-8"

# command_exists
command_exists () {
    type "$1" >/dev/null 2>&1
}

if command_exists nvim; then
    export EDITOR="nvim"
else
    export EDITOR="vim"
fi


# -----------------------------------------------------------------
# HOMEBREW (Apple Silicon, Intel mac, or Linuxbrew)
# -----------------------------------------------------------------

if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi


# -----------------------------------------------------------------
# BUILD TOOLS
# -----------------------------------------------------------------

if command_exists clang; then
    export CC="clang"
fi


# -----------------------------------------------------------------
# GIT
# -----------------------------------------------------------------

export GIT_EDITOR="$HOME/bin/git-editor-wrapper"

alias gco="git checkout"
alias gps="git push"
alias gpl="git pull"
alias gm="git merge"
alias gcm="git commit -m"
alias gc="git commit"
alias gs="git status"
alias gb="git branch"
alias gd="git diff"
alias gcp="git cherry-pick"
alias ga="git add"
alias gmv="git mv"
alias grm="git rm"
alias gplr="git pull --rebase"

# make diff work like git-diff
alias diffg="git diff --no-index --"

# gack = ack search only files in git
alias gack="git ls-files -oc --exclude-standard | ack -x"


# -----------------------------------------------------------------
# PROGRAMMING LANGUAGES
# -----------------------------------------------------------------

# rvm
if [ -s "$HOME/.rvm/scripts/rvm" ]; then
    . "$HOME/.rvm/scripts/rvm"
fi


# -----------------------------------------------------------------
# ALIASES
# -----------------------------------------------------------------

# Linux only — `free -m` doesn't exist on macOS.
if [ "$(uname)" = "Linux" ]; then
    alias free='free -m'
fi

# macOS DNS cache flush
if [ "$(uname)" = "Darwin" ]; then
    alias flushdns='dscacheutil -flushcache'
fi

alias ta='tmux a -t'

if command_exists nvim; then
    export vim=nvim
else
    export vim=vim
fi

vim () {
    if [ -f 'Session.vim' ] && [ $# -eq 0 ]; then
        command $vim -S Session.vim
    else
        command $vim "$@"
    fi
}

# keep environment when doing sudo su
alias ssu='sudo su -m'

# show non-loopback IPs
alias ip10="ifconfig | grep '10\\.'"

fgr () {
    fgrep -r -n "$@" .
}


# -----------------------------------------------------------------
# LS, GREP, AND DIRCOLORS
# -----------------------------------------------------------------

# BSD ls (macOS) accepts -G for color; GNU ls (Linux) uses --color=auto.
if ls --color=auto >/dev/null 2>&1; then
    alias ls="command ls -hB --color=auto"
else
    alias ls="command ls -hBG"
fi

alias ll="ls -l"
alias l.="ls -d .*"
alias ll.="ls -dl .*"
alias lla="ls -al"


# -----------------------------------------------------------------
# PATH
# -----------------------------------------------------------------

puniq () {
    echo "$1" | tr : '\n' | nl | sort -u -k 2,2 | sort -n |
        cut -f 2- | tr '\n' : | sed -e 's/:$//' -e 's/^://'
}

export PATH="$HOME/bin:$PATH"
PATH=$(puniq "$PATH")


# -----------------------------------------------------------------
# SOURCING LOCAL .SHELLRC
# -----------------------------------------------------------------

if [ -f ~/.shellrc.local ]; then
    . ~/.shellrc.local
fi
