#!/usr/bin/env bash
#
# Install dotfiles into $HOME.
#
# Idempotent: safe to re-run. Existing files that conflict with tracked
# dotfiles are moved to ~/.dotfiles-backup-<timestamp>/ before the repo
# is laid down.
#
# Usage:
#   curl -fsSL https://raw.githubusercontent.com/kballenegger/dotfiles/dotfiles/bin/install-dotfiles | bash
# Or, after cloning manually:
#   bash bin/install-dotfiles
#
# Env vars:
#   DOTFILES_REPO    git URL to clone (default: https://github.com/kballenegger/dotfiles.git)
#   DOTFILES_BRANCH  branch to check out (default: dotfiles)

set -euo pipefail

REPO_URL="${DOTFILES_REPO:-https://github.com/kballenegger/dotfiles.git}"
BRANCH="${DOTFILES_BRANCH:-dotfiles}"
BACKUP_DIR="$HOME/.dotfiles-backup-$(date +%Y%m%d-%H%M%S)"
STAGING_DIR="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-install.XXXXXX")"

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

cleanup() { rm -rf "$STAGING_DIR"; }
trap cleanup EXIT

command -v git >/dev/null 2>&1 || die "git is required"

cd "$HOME"

# If $HOME is already this dotfiles repo, just refresh submodules and exit.
if [ -d "$HOME/.git" ] && git -C "$HOME" remote get-url origin 2>/dev/null | grep -qi 'dotfiles'; then
    log "Existing dotfiles repo detected at \$HOME — pulling latest"
    git -C "$HOME" fetch --quiet origin "$BRANCH"
    git -C "$HOME" merge --ff-only "origin/$BRANCH" || warn "could not fast-forward; resolve manually"
    log "Updating submodules"
    git -C "$HOME" submodule update --init --recursive --jobs 8 || warn "some submodules failed"
    log "Done."
    exit 0
fi

log "Cloning $REPO_URL ($BRANCH) into staging"
git clone --branch "$BRANCH" --recurse-submodules --jobs 8 "$REPO_URL" "$STAGING_DIR/repo" || \
    die "clone failed"

log "Backing up conflicting files to $BACKUP_DIR"
mkdir -p "$BACKUP_DIR"
moved_any=0
while IFS= read -r entry; do
    [ "$entry" = "." ] || [ "$entry" = ".." ] && continue
    [ "$entry" = ".git" ] && continue
    if [ -e "$HOME/$entry" ] || [ -L "$HOME/$entry" ]; then
        mv "$HOME/$entry" "$BACKUP_DIR/"
        moved_any=1
    fi
done < <(ls -A "$STAGING_DIR/repo")

if [ "$moved_any" -eq 0 ]; then
    rmdir "$BACKUP_DIR"
    log "No conflicts — nothing to back up"
fi

log "Moving repo contents into \$HOME"
# Move .git first, then everything else, so $HOME becomes the working tree.
mv "$STAGING_DIR/repo/.git" "$HOME/.git"
shopt -s dotglob nullglob
mv "$STAGING_DIR/repo/"* "$HOME/" 2>/dev/null || true
shopt -u dotglob nullglob

log "Verifying working tree"
git -C "$HOME" status --porcelain >/dev/null || die "post-install git check failed"

log "Done. Dotfiles installed."
[ "$moved_any" -eq 1 ] && log "Originals backed up to: $BACKUP_DIR"
cat <<'EOF'

Next steps:
  1. Set up your git identity:
       git config --global user.name  "Your Name"
       git config --global user.email "you@example.com"
  2. (Optional) change shell to zsh:
       chsh -s "$(command -v zsh)"
  3. (Optional) install packages:
       bash ~/bin/setup-packages.sh
EOF
